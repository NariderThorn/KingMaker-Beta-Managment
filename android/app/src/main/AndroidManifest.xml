<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to trigger Android's own package installer for full-APK updates
         (the "Update now (full)" button) — the same permission Epic's launcher,
         F-Droid, and every other non-Play-Store updater needs. Android still
         requires the user to grant this once, and still shows its own install
         confirmation dialog every time — this permission only lets the app
         hand the file to that installer, it can't skip the user's confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.KingdomLedger">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets us hand the downloaded APK file to the system installer as a
             content:// URI, which is required on modern Android (raw file:// URIs
             aren't accepted between apps anymore). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.statelandledger.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
